# Required: used by every agent's LLM calls and by the retriever's embeddings.
OPENAI_API_KEY=

# Optional: which model backs each agent (see backend/llm.py for defaults).
# ANALYZER_MODEL=gpt-4o-mini
# PLANNER_MODEL=gpt-4o
# CODER_MODEL=gpt-4o-mini
# VERIFIER_MODEL=gpt-4o
# ROUTER_MODEL=gpt-4o
# DEBUGGER_MODEL=gpt-4o-mini
# REPORTER_MODEL=gpt-4o-mini

# Optional: loop and sandbox limits (see backend/config.py for defaults).
# MAX_STEPS=20
# MAX_DEBUG_ATTEMPTS=3
# EXEC_TIMEOUT_SECONDS=600
# CPU_LIMIT=4
# MEM_LIMIT=6g
# ALLOW_NETWORK=false

# Optional: retriever, only relevant with 100+ input files.
# MANY_FILES_THRESHOLD=100
# RETRIEVER_TOP_K=100
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: MCP tool server and Docker sandbox image.
# MCP_SERVER_URL=http://127.0.0.1:8011/mcp
# RUNTIME_IMAGE=datasci-runtime:latest

# Optional: trace every agent's LLM calls in LangSmith (https://smith.langchain.com).
# Get an API key from your LangSmith settings page.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=DataScientistOS
